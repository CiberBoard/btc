```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
.venv/
venv/
env/
requirements.txt.bak

# Logs and temp files
*.log
*.tmp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
dist/
build/
*.egg-info/
.coverage
htmlcov/
coverage/
.mypy_cache/
.pytest_cache/
```